{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lamoumusicpromoteroficial",
  "main": "backend/worker-v10.js",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "APP_ENV": "production"
  }
}
