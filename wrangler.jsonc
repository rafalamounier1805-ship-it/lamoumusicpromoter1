{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lamoumusicpromoteroficial",
  "main": "backend/worker-entry-v10.js",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lamou-music-promoter",
      "database_id": "c62bd9a3-fb46-4ed0-81e0-8853387f4167"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "SPOTIFY_CLIENT_ID": "8a9c328f33b14bad9b48473d238925fc"
  }
}
