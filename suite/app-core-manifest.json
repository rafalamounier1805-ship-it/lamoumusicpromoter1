{
  "name": "APP CORE CUSTOM — Base Universal",
  "version": "2.1.1",
  "catalogSchemaVersion": "1.0.0",
  "studio": {
    "name": "LAMOU CORE Studio",
    "mode": "module-registry",
    "source": "suite/core-studio/",
    "createsApplications": false,
    "purpose": "Catalogar e governar módulos, ferramentas, dependências, plugins, substituições e versões da base universal LAMOU IA."
  },
  "central": "LAMOU IA — Central Oficial",
  "principles": {
    "noFakeActions": true,
    "moduleIsNotPlugin": true,
    "providerIndependence": true,
    "freeTierMustNotBlockApp": true,
    "unsafeAutomaticMigrationForbidden": true,
    "versionHistoryRequiresEvidence": true,
    "testBeforeProduction": true,
    "dependencyValidation": true,
    "auditability": true,
    "securityIsBase": true,
    "passwordPlaintextStorageForbidden": true
  },
  "authUx": {
    "semanticForms": true,
    "passwordManagerCompatible": true,
    "autocomplete": ["username", "new-password", "current-password"],
    "showHidePassword": "required",
    "savePasswordOptIn": "required",
    "reuseSavedPasswordOptIn": "required",
    "credentialStorageOwner": "browser-or-os-password-manager",
    "localTestCredentialStorage": "salted-hash-only",
    "productionCredentialStorage": "secure-backend-or-idp",
    "neverStorePlaintextInLocalStorage": true
  },
  "mandatoryTransversal": [
    "TEST MODE / Sandbox",
    "PRODUCT CRITIC",
    "IMPROVE MODE",
    "MODULE MANAGER",
    "APP HEALTH",
    "PRE-PRODUCTION CHECK",
    "OFFICIAL VERSION REGISTRY",
    "CORE UPDATE CENTER",
    "PWA UPDATE CHANNEL",
    "PASSWORD MANAGER UX"
  ],
  "moduleCatalog": "suite/core-studio/modules.js",
  "modules": [
    "identity",
    "auth",
    "users",
    "workspaces",
    "rbac-abac",
    "ui-shell",
