{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lamoumusicpromoteroficial",
  "main": "backend/worker-v10.js",
  "compatibility_date": "2026-08-14",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lamou-music-promoter",
      "database_id": "COLOQUE_O_DATABASE_ID_AQUI"
    }
  ],
  "vectorize": [
    {
      "binding": "MUSIC_VECTOR",
      "index_name": "COLOQUE_O_INDEX_VECTORIZE_AQUI"
    }
  ],
  "vars": {
    "APP_ENV": "production"
  }
}
