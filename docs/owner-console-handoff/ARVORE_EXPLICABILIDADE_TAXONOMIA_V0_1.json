  "math": {
    "higher_is_better": "clamp(100 * (value - minimum_acceptable) / (target - minimum_acceptable), 0, 100)",
    "lower_is_better": "clamp(100 * (maximum_acceptable - value) / (maximum_acceptable - target), 0, 100)",
    "dimension_health": "sum(weight_i * score_i) / sum(weight_i)",
    "overall_health": "sum(dimension_weight_d * dimension_health_d) / sum(dimension_weight_d)",
    "missing_target_or_denominator": "NOT_CALCULABLE"
  },
